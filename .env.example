# ============================================================
# CourtSide — primjer konfiguracije (kopiraj u .env i popuni)
# .env se NIKADA ne commita (vidi .gitignore). Za predaju: .env-tajne.zip
# ============================================================

# ----- Baza podataka (SQL Server) -----
DB_NAME=180099
DB_SA_PASSWORD=Your_Strong_Passw0rd!
# Konekcijski string koji API koristi (u dockeru host = sqlserver, lokalno = localhost,1433)
CONNECTION_STRING=Server=sqlserver,1433;Database=180099;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True;Encrypt=False;

# ----- JWT -----
JWT_TOKEN_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ISSUER=CourtSide
JWT_AUDIENCE=CourtSideClients
JWT_EXPIRY_MINUTES=120

# ----- RabbitMQ -----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=courtside.exchange
RABBITMQ_QUEUE=courtside.notifications

# ----- SMTP (npr. Mailtrap sandbox) -----
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=true
SMTP_FROM=no-reply@courtside.local

# ----- Stripe (test/sandbox) -----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- API -----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80
# Putanja za upload-ovane slike unutar kontejnera
UPLOADS_PATH=/app/wwwroot/uploads
# Dozvoljeni CORS origini (zarezom odvojeni)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ----- Vrijeme -----
# Lokalna zona sportskog centra; termini se cuvaju kao lokalno vrijeme, audit trenuci ostaju UTC.
APP_TIME_ZONE=Europe/Sarajevo
